# ===== ديسكورد =====
DISCORD_TOKEN=
# سيرفر واحد عشان الأوامر تظهر فوراً (فاضي = global، بياخد وقت عشان يظهر)
DISCORD_GUILD_ID=
# رتبة تقدر تلغي أي جوب
ADMIN_ROLE_ID=
# الرومات المسموح فيها بالأوامر، مفصولة بفاصلة (فاضي = كل الرومات)
ALLOWED_CHANNEL_IDS=

# ===== gofile (اختياري) =====
GOFILE_TOKEN=

# ===== محرك التبييض =====
# builtin = البوت بيبيّض بنفسه (الافتراضي) | remote = سيرفر Colab | cli = manga-translator-ui محلي
CLEAN_ENGINE=builtin
# فولدر موديل الكشف (بيتحمّل أوتوماتيك أول تشغيل، حوالي 95MB)
MODEL_DIR=models
# عدد الصفحات اللي بتتبيّض مع بعض
PAGE_CONCURRENCY=2

# remote: سيرفر GPU عن بعد (Colab، شوف SETUP.md)
WORKER_URL=
WORKER_TOKEN=
# cli: تشغيل manga-translator-ui على نفس الجهاز
TRANSLATOR_REPO=/root/manga-translator-ui
TRANSLATOR_PYTHON=/root/manga-translator-ui/.venv/bin/python
WORK_ROOT=/root/whiten-work

# ===== الطابور =====
QUEUE_WORKERS=1
MAX_PENDING=20
MAX_UPLOAD_MB=25
MAX_DOWNLOAD_MB=500
